generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Organization {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  logo     String?
  industry String?

  /// PROVISIONING | ACTIVE | FAILED | DELETING.
  /// An organization is registered in the user-management service and given its
  /// own role definitions before it may be used; anything but ACTIVE is refused
  /// by `orgMiddleware`, so a half-built organization is never usable.
  provisioningStatus String    @default("ACTIVE")
  umsSyncedAt        DateTime?

  ownerId String
  owner   User   @relation("OrgOwner", fields: [ownerId], references: [id])

  users   OrgUser[]
  forms   Form[]
  invites OrgInvite[]
  teams   Team[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrgUser {
  id     String @id @default(cuid())
  orgId  String
  userId String

  // This row IS the organization-level role assignment. `role` holds the role
  // name (OWNER, ADMIN, CREATOR, ANALYST, VIEWER); `roleId` references the role
  // *definition* in the user-management service, which owns what that role is
  // permitted to do, and is scoped to this organization.
  roleId String?
  role   String  @default("VIEWER")

  invitedBy String?
  joinedAt  DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@index([userId])
}

/// A pending or resolved invitation to join an organization.
///
/// Invites are keyed by email rather than userId so someone who has not signed
/// up yet can still be invited; the invite is matched on their first login.
model OrgInvite {
  id    String @id @default(cuid())
  email String
  orgId String

  /// RBAC role applied when the invite is accepted.
  roleId String?
  role   String  @default("CREATOR")

  /// PENDING | ACCEPTED | REJECTED | REVOKED
  inviteStatus String @default("PENDING")

  invitedBy   String
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// One live invite per email per org. Resolved invites are updated in place
  /// rather than accumulating, so re-inviting someone reuses this row.
  @@unique([orgId, email])
  @@index([email, inviteStatus])
  @@index([orgId, inviteStatus])
}

/// Last-known-good role definitions for one organization.
///
/// Read only when the user-management service cannot be reached. Without it a
/// restart during an outage would be a full outage, because the in-memory cache
/// starts empty and there would be nothing to authorize against.
model RoleDefinitionCache {
  id        String   @id @default(cuid())
  appId     String
  orgId     String
  payload   String   @db.LongText
  fetchedAt DateTime @default(now())

  @@unique([appId, orgId])
}

/// Work owed to the user-management service.
///
/// Written in the same transaction as the local change it mirrors, so a
/// membership change is never lost and never blocks on a remote call. Drained
/// by a worker with backoff; `npm run ums:reconcile` repairs anything that dies.
model UmsOutbox {
  id String @id @default(cuid())

  /// ORG_REGISTER | ROLE_SEED | MEMBER_ADD | ROLE_ASSIGN | MEMBER_REMOVE | ORG_DELETE
  kind    String
  orgId   String
  payload String @db.LongText

  /// PENDING | DONE | DEAD
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  lastError     String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([orgId])
}

/// A team inside an organization. Teams are flat organizational buckets that
/// group forms and act as targets for per-form sharing. They carry no
/// permissions of their own — a user's access is governed by their organization
/// role alone, plus explicit form shares.
model Team {
  id     String @id @default(cuid())
  orgId  String

  name        String
  slug        String
  description String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The team every organization starts with, so a new form always has a home.
  /// Cannot be deleted; forms fall back to it when their own team is removed.
  isDefault Boolean @default(false)

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  members TeamMember[]
  forms   Form[]

  @@unique([orgId, slug])
  @@index([orgId])
}

/// Membership of a user in one team. A pure join carrying no role — a user's
/// role lives on their organization membership (`OrgUser.role`).
///
/// The `@@unique([teamId, userId])` key enforces one membership per person per
/// team.
model TeamMember {
  id     String @id @default(cuid())
  teamId String
  userId String

  addedBy   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
}

model User {
  id                String  @id
  email             String  @unique
  firstName         String?
  lastName          String?
  username          String? @unique
  phone             String?
  gender            String?
  address           String?
  additionalDetails String? @db.LongText

  orgs            OrgUser[]
  ownedOrgs       Organization[] @relation("OrgOwner")
  teamMemberships TeamMember[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Form {
  id          String  @id @default(cuid())
  orgId       String
  name        String
  slug        String
  description String? @db.Text

  /// The team that groups this form. Access is governed by the organization
  /// role and explicit shares, not by the owning team.
  /// Nullable so pre-existing rows survive the migration; new forms always land
  /// in a team.
  teamId String?

  /// How much of a response anyone may see, whatever role they hold:
  /// STANDARD | ANONYMOUS | BLIND_REVIEW | RESTRICTED
  ///
  /// A promise made to respondents outranks any permission grant, so this locks
  /// once the first response arrives.
  responsePolicy         String    @default("STANDARD")
  responsePolicyLockedAt DateTime?

  schema   String @db.LongText // JSON
  settings String @db.LongText // JSON

  isPublished Boolean @default(false)

  submissions Submission[]
  surveyResponseSessions SurveyResponseSession[]
  drafts      Draft[]
  publicSessions PublicFormSession[]
  uniqueValues   SubmissionUniqueValue[]

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  team   Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  shares FormShare[]

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([teamId])
}

/// An exception to the role model: access to one specific form, for one person
/// or one team.
///
/// Roles set the baseline, but real work is full of one-offs - a contractor for
/// six weeks, an executive who wants one report. Without an exception mechanism
/// admins grant permanent roles to solve temporary problems.
model FormShare {
  id     String @id @default(cuid())
  formId String

  /// USER | TEAM
  principalType String
  /// A userId or a teamId, depending on principalType.
  principalId   String

  /// Response access conferred: NONE | AGGREGATE | REDACTED | FULL | EXPORT
  level String @default("AGGREGATE")

  /// Whether the grantee may also edit the form, not only read its responses.
  canEdit Boolean @default(false)

  /// Null means indefinite. An access list that only grows stops reflecting
  /// reality, so shares are meant to expire.
  expiresAt DateTime?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, principalType, principalId])
  @@index([principalType, principalId])
  @@index([formId])
}

model Submission {
  id     String @id @default(cuid())
  formId String

  data String @db.LongText // JSON

  ip        String?
  userAgent String?

  isRead           Boolean @default(false)
  tags             String  @default("[]") // JSON array stored as string
  processingStatus String  @default("pending") // pending | processing | done | failed

  createdAt DateTime @default(now())

  form             Form              @relation(fields: [formId], references: [id], onDelete: Cascade)
  processingResult ProcessingResult?
  auditLog         AuditLog?
  uniqueValues     SubmissionUniqueValue[]

  @@index([formId])
  @@index([createdAt])
  // Optional analytics/read-path index; additive and safe for existing rows.
  @@index([formId, createdAt])
}

/// The uniqueness guarantee for fields marked `unique` in the form schema.
///
/// The old check read every submission for the form, compared answers in Node
/// and then inserted. Two requests that interleave between the read and the
/// insert both see "not taken" and both succeed, so the constraint that the
/// form promised was never actually enforced — and the read cost grew with the
/// number of responses, on a public endpoint.
///
/// This is the same shape as `AuditLog` for votes: the pre-check stays as a
/// fast, friendly way to turn away the common case, and this row is the
/// guarantee. The claim happens after the submission row exists so it can
/// reference it; whoever loses the race has their submission deleted again,
/// which cascades the claims they had already made.
model SubmissionUniqueValue {
  id           String @id @default(cuid())
  formId       String
  fieldId      String @db.VarChar(191)

  /// sha256 of the canonicalised answer (trimmed, lower-cased). Hashed rather
  /// than stored raw because this table would otherwise be a plaintext index
  /// of every email address and identity number ever submitted, sitting next
  /// to a public endpoint that queries it.
  valueHash    String @db.VarChar(64)

  submissionId String

  createdAt DateTime @default(now())

  form       Form       @relation(fields: [formId], references: [id], onDelete: Cascade)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([formId, fieldId, valueHash])
  @@index([submissionId])
}

/// A respondent's session on a public form.
///
/// Everything a public form needs to scope to "this respondent, this visit"
/// used to be scoped to their email address instead, which is not a secret and
/// which the browser chooses for itself. This row is the secret: the server
/// mints an unguessable token, keeps only its hash, and the browser presents
/// the token on later requests.
///
/// `verifiedIdentity` is deliberately separate from anything the client sends.
/// It is written only when the server itself has verified an identity, so a
/// caller cannot claim to be somebody by saying so. There is no OTP backend
/// yet, so today it is always null and every identity-scoped path stays shut —
/// which is the correct state for a check that does not exist.
model PublicFormSession {
  id     String @id @default(cuid())
  formId String

  /// sha256 of the token. A leaked database backup must not hand out live
  /// sessions.
  tokenHash String @db.VarChar(64) @unique

  /// Set only by a server-side verification step, never from request input.
  verifiedIdentity String?   @db.VarChar(320)
  verifiedAt       DateTime?

  /// Per-session budgets. These endpoints answer questions about other
  /// people's data or spend the organization's third-party credentials, so a
  /// session may ask a limited number of times before it has to be replaced —
  /// and minting a session is itself rate limited per address.
  uniqueChecks   Int @default(0)
  externalChecks Int @default(0)

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  form   Form    @relation(fields: [formId], references: [id], onDelete: Cascade)
  drafts Draft[]

  @@index([formId])
  @@index([expiresAt])
}

/// A counter shared by every replica, for budgets that must hold across the
/// whole deployment rather than per process.
///
/// `express-rate-limit`'s default store lives in memory, so a limit of 100 is
/// really 100 per replica per restart. That is fine for coarse abuse control
/// and useless for "this form may spend its API credentials 200 times an
/// hour", which is a fact about the organization, not about one process.
model PublicRateCounter {
  scope       String   @db.VarChar(191)
  windowStart DateTime
  count       Int      @default(0)

  @@id([scope, windowStart])
  @@index([windowStart])
}

// Stores computed output after post-submission processing (assessment scores, vote tallies)
model SurveyResponseSession {
  id          String   @id @default(cuid())
  formId      String
  tokenHash   String
  data        String   @db.LongText
  stepIndex   Int      @default(0)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  form Form @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@unique([formId, tokenHash])
  @@index([formId, completedAt])
}

model ProcessingResult {
  id           String   @id @default(cuid())
  submissionId String   @unique
  formId       String
  type         String // "assessment" | "voting"
  result       String   @db.LongText // JSON — scores, pass/fail, vote counts, etc.
  processedAt  DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([formId])
}

// Immutable per-vote record for voting duplicate prevention and audit trail
model AuditLog {
  id           String   @id @default(cuid())
  formId       String
  submissionId String   @unique
  // Namespaced and canonical: "ip:203.0.113.9" or "email:ada@example.com".
  // The prefix keeps an address and an email that happen to read alike from
  // colliding, and 255 leaves room for an address at the RFC maximum.
  identifier   String   @db.VarChar(255)
  createdAt    DateTime @default(now())

  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // The duplicate-vote guarantee. An index alone only makes the lookup fast;
  // it is this constraint that makes two simultaneous votes from one identifier
  // impossible, because the database rejects the second insert rather than
  // application code losing a race it cannot win.
  @@unique([formId, identifier])
  @@index([formId])
}

model Draft {
  id        String   @id @default(cuid())
  formId    String

  /// Historical key: the respondent's email or phone, taken from the query
  /// string. It is not a secret, so it never scopes a read any more — see
  /// `sessionId`. Kept because existing rows carry it and because a future
  /// server-verified OTP flow needs somewhere to record whose draft this is.
  /// The unique constraint that used to sit on it is gone: it was the index
  /// that made an email address into a lookup key.
  identity  String?

  /// The row that actually authorises access. Null only for drafts written
  /// before this column existed; those are unreachable by the new lookup,
  /// which is the intended outcome — they were readable by anyone who knew an
  /// email address.
  sessionId String?

  data      String   @db.LongText // JSON field values
  stepIndex Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  form    Form               @relation(fields: [formId], references: [id], onDelete: Cascade)
  session PublicFormSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([formId, sessionId])
  @@index([formId])
}

model Template {
  id          String  @id @default(cuid())
  name        String
  description String?
  category    String
  schema      String  @db.LongText // JSON
  settings    String  @db.LongText // JSON
  isStatic    Boolean @default(false)
  orgId       String?
  createdBy   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orgId])
}
