# Frontend Environment Variables
# Copy this file to .env and update values for your environment

# Backend API URL
VITE_API_URL=http://localhost:12001

# Public frontend base URL used for preview/share links (optional)
# If not set, the app falls back to `window.location.origin` at runtime.
# Example for local dev where Vite serves on 5173:
VITE_PUBLIC_URL=http://localhost:12000

# For production deployment, update to your actual backend URL:
# VITE_API_URL=https://your-backend-domain.com

# --- Backend (copy into backend/.env) ---------------------------------------
# DMS_ENABLED=true
# DMS_BASE_URL=https://apidev.sifymodernization.digital/dms/api
# DMS_API_KEY=
# DMS_TENANT_ID=
# DMS_FOLDER_MAP_SUBMISSIONS=submissions
# DMS_FOLDER_MAP_SUPPORT_DOCS=support-docs
# DMS_FOLDER_MAP_BRANDING=branding
# DMS_FOLDER_MAP_SIGNATURE=signatures
