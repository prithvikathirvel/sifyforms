# Frontend Environment Variables
# Copy this file to .env and update values for your environment

# Backend API URL
VITE_API_URL=http://localhost:12001

# Public frontend base URL used for preview/share links (optional)
# If not set, the app falls back to `window.location.origin` at runtime.
# Example for local dev where Vite serves on 5173:
VITE_PUBLIC_URL=http://localhost:12000

# Cloudflare Turnstile public site key. Cloudflare's always-pass invisible test key:
# 1x00000000000000000000BB
VITE_TURNSTILE_SITE_KEY=

# For production deployment, update to your actual backend URL:
# VITE_API_URL=https://your-backend-domain.com

# --- Backend (copy into backend/.env) ---------------------------------------
# Cloudflare Turnstile server secret. Never expose this as a VITE_ variable.
# Cloudflare's always-pass test secret (it intentionally does not test replay):
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# To test the timeout-or-duplicate path, Cloudflare provides:
# TURNSTILE_SECRET_KEY=3x0000000000000000000000000000000AA
# Test secrets are rejected unless this is explicitly enabled outside production:
# TURNSTILE_ALLOW_TEST_KEYS=false
# Comma-separated production hostnames; leave empty only for local test keys.
# TURNSTILE_EXPECTED_HOSTNAMES=forms.example.com,www.forms.example.com
# Express trusts only a local Nginx proxy by default. Override with a known proxy CIDR/name.
# TRUST_PROXY=loopback
# DMS_ENABLED=true
# DMS_BASE_URL=https://apidev.sifymodernization.digital/dms/api
# DMS_API_KEY=
# DMS_TENANT_ID=
# DMS_FOLDER_MAP_SUBMISSIONS=submissions
# DMS_FOLDER_MAP_SUPPORT_DOCS=support-docs
# DMS_FOLDER_MAP_BRANDING=branding
# DMS_FOLDER_MAP_SIGNATURE=signatures
